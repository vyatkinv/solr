+    measurement.record(
+        idle, Attributes.builder().putAll(baseAttrs).put(STATE_KEY_ATTR, "idle").build());
+    measurement.record(
+        pending, Attributes.builder().putAll(baseAttrs).put(STATE_KEY_ATTR, "pending").build());
+    measurement.record(
